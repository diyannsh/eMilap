# ==============================================================================
# e-Milap — Production Environment Variables Template
# ==============================================================================
# DO NOT COMMIT POPULATED CREDENTIALS.
# Store production secrets in your hosting provider's Secret Manager (Render,
# Railway, Cloudflare, etc.).
# ==============================================================================

# Core Application Environment
NODE_ENV=production
PORT=4000

# Web Origin (Exact HTTPS URL of the hosted frontend for CORS & cookies)
# e.g., https://foundnear.pages.dev or https://foundnear.yourcollege.edu
WEB_ORIGIN=https://your-app-domain.com

# Managed PostgreSQL Database URL (with pgvector extension and TLS/SSL required)
# e.g., Neon: postgresql://user:password@ep-xyz.us-east-2.aws.neon.tech/foundnear?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE_NAME?sslmode=require

# Session Security
# Generate using: openssl rand -hex 32
SESSION_SECRET=GENERATE_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
SESSION_COOKIE_NAME=foundnear.sid
SESSION_TTL_HOURS=168

# Storage Mode (MUST be false in production; local container filesystem is ephemeral)
STORAGE_LOCAL=false

# Durable S3-Compatible Object Storage
# For Cloudflare R2:
#   S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
#   S3_REGION=auto
#   S3_FORCE_PATH_STYLE=false
# For AWS S3:
#   Leave S3_ENDPOINT blank/commented out
#   S3_REGION=us-east-1
#   S3_FORCE_PATH_STYLE=false
S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_FORCE_PATH_STYLE=false
S3_ACCESS_KEY_ID=YOUR_S3_COMPATIBLE_ACCESS_KEY_ID
S3_SECRET_ACCESS_KEY=YOUR_S3_COMPATIBLE_SECRET_ACCESS_KEY

# Storage Buckets (CRITICAL: Must be two separate buckets with distinct permissions)
# 1. Reports Bucket: For public item photos (read access permissible for authenticated community members)
S3_BUCKET_REPORTS=foundnear-prod-reports
# 2. Evidence Bucket: Strictly PRIVATE. NEVER make public. Only accessible via authorized presigned URLs.
S3_BUCKET_EVIDENCE=foundnear-prod-private-evidence

# AI Embedding Service (Optional / Milestone 2)
# Keep empty or disabled for initial pilot release (deterministic matcher runs automatically)
# AI_SERVICE_URL=https://ai.your-domain.com
# AI_SERVICE_TOKEN=GENERATE_SECURE_AUTH_TOKEN

{
  "name": "emilap",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "apps/api",
    "apps/ai",
    "packages/contracts"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:all": "npm run build && npm run build:api",
    "start": "node apps/api/dist/server.js",
    "preview": "vite preview",
    "dev:all": "concurrently \"npm:dev\" \"npm:dev:api\" \"npm:dev:ai\"",
    "dev:api": "npm run dev --workspace @foundnear/api",
    "dev:ai": "npm run dev --workspace @foundnear/ai",
    "dev:worker": "npm run dev:worker --workspace @foundnear/api",
    "build:api": "npm run build --workspace @foundnear/api",
    "build:ai": "npm run build --workspace @foundnear/ai",
    "test:api": "npm run test --workspace @foundnear/api",
    "typecheck:api": "npm run typecheck --workspace @foundnear/api",
    "db:up": "docker compose -f infra/compose.yaml up -d postgres",
    "db:down": "docker compose -f infra/compose.yaml down",
    "db:migrate": "node database/scripts/migrate.mjs",
    "db:verify": "node database/scripts/verify-db.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@react-three/postprocessing": "^2.19.1",
    "gsap": "^3.15.0",
    "lenis": "^1.3.27",
    "lucide-react": "^0.468.0",
    "maath": "^0.10.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "autoprefixer": "^10.6.1",
    "concurrently": "^9.0.0",
    "postcss": "^8.5.31",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.0",
    "vite": "^6.0.5"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}

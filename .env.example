# e-Milap — local development template only.
# Copy to .env; replace placeholders before use. Never commit populated secrets.
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://foundnear:foundnear_dev@localhost:5432/foundnear?schema=public

SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
SESSION_COOKIE_NAME=foundnear.sid
SESSION_TTL_HOURS=168

# S3-compatible object storage (local or managed provider)
# For local development: endpoint=http://localhost:9000; managed S3 may omit endpoint.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET_REPORTS=foundnear-reports
S3_BUCKET_EVIDENCE=foundnear-private-evidence
S3_ACCESS_KEY_ID=replace-with-local-or-managed-access-key
S3_SECRET_ACCESS_KEY=replace-with-local-or-managed-secret-key
S3_FORCE_PATH_STYLE=true

# Optional AI service. Deterministic matching must work when disabled/unavailable.
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TOKEN=replace-with-optional-ai-token
